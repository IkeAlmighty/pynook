# stdlib: utest.nk

Mock: (root) {

	return_value: null
	
	__access__: (member) {
		if member != "return_value" { return Mock() }
		else { return return_value }
	}
}

patch: (parent, member_patch_name) {
	parent.__access__: (member_access_name) {
		if member_access_name == member_patch_name {
			return Mock()
		}
		else {
			return parent[member_access_name]
		}
	}
}

assert_true: (expr) {
	if expr != true {
		write(stdio, "Test Failed")
	}

	return expr
}

assert_false: (){}
