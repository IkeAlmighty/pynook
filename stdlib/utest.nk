# stdlib: utest.nk

Mock: (root) {

	return_value: null
	
	__access__: (member, resolve) {
		if member != "return_value" { return Mock() }
		else { resolve(member) }
	}
}

patch: (parent, member_patch_name) {
	parent.__access__: (member_access_name, resolve) {
		if member_access_name == member_patch_name {
			return Mock()
		}
		else {
			resolve(member_access_name)
		}
	}
}

assert_true: (expr) {
	if expr != true {
		write(stdio, "Test Failed")
	}

	return expr
}

assert_false: (){}
