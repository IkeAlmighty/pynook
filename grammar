
# file production exists so that implementation can determined control flow properties,
# but it is is transformed into a runtime scope without the enclosing '{' '}':
file := block 

block := (statement)*
statement := ('ignore'? (assignment | destructure) ) | expr |  end_ctr_flow | loop | branch | case | default | throw | trycatch) terminator

end_ctr_flow := 'leave' | 'continue' | return | collect
return := 'return' (assignment | expr)?
collect := 'collect' (assignment | expr )?

scope := '{' block '}'

list := '[' items? ']'
set := 'set' '[' items? ']'
items := item (',' item)*
item := spread? expr 

throw := 'throw' expr
trycatch := 'try' scope ('catch' identifier scope)* ('finally' scope)?

assignment := (string | target) ':' ( def_func | def_root_func | expr )
target := identifier ( ( '.' identifier ) | subscript )*

destructure := ( destruct_scope  | destruct_list ) ':' expr

destruct_scope := '{' pattern_sequence '}'
destruct_list := '[' pattern_sequence ']'

pattern_sequence := pattern (',' pattern)*
pattern := identifier | (identifier ':' pattern_obj)
pattern_obj := identifier | destruct_scope | destruct_list

loop := while | dowhile | for | forin 
branch := if | switch

while := 'while' expr scope
dowhile := 'do' scope 'while' expr

for := 'for' statement ';' expr ';' statement scope
forin := 'for' identifier 'in' (expr) scope

if := 'if' expr scope elif* else?
elif := 'elif' expr scope
else := 'else' scope
switch := 'switch' expr scope

# case & default are enforced by semantic analysis to only exist as children of switch:
case := 'case' literal scope 
default := 'default' scope 

def_func := '(' params? ')' scope
def_root_func := '(' 'root' (',' params)? ')' scope
params := param (',' param)* spread?
param :=  identifier (':' expr)?

expr := infix
infix := term (op term)* # precedence-parser
term := spread? postfix
postfix := primary ( call | subscript | ( '.' identifier ) )*
primary := literal | identifier | ( '(' expr ')' )
call := '(' args? ')'

subscript := '[' expr? (':' expr?)?']'

spread := '..'
op := r'[/-+%*^><=!#]+'
args := arg (',' arg)* spread?
arg := (identifier ':')? expr

literal := int | float | string | boolean | binary | hexadecimal | scope | list | set | 'null' | 'none'
identifier := r'[a-zA-Z_][0-9a-zA-Z_]*'
terminator := ',' | ';' | '\n'

int := r'[0-9]+'
float := int '.' int
string := r'\".*\"' | r"\'.*\'"
boolean := 'true' | 'false'
binary := r'b[0-1]+'
hexadecimal := r'h[0-9a-fA-F]+'
